{
  "name": "@lako/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Themeable React components and Lako authentication UI, without framework dependencies.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Samryetha-Development/lako-ui.git"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./auth.css": "./src/auth.css",
    "./ui.css": "./src/ui.css"
  },
  "files": [
    "dist",
    "src/auth.css",
    "src/ui.css",
    "LICENSE",
    "RELEASING.md",
    "VALIDATION.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p playground/tsconfig.json",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "dev": "vite playground --host 127.0.0.1 --port 5400 --strictPort",
    "build:playground": "vite build playground --outDir dist",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^26.1.0",
    "typescript": "^5.7",
    "vite": "8.2.2"
  }
}
